<refentry lang="&language;">
<refentryinfo>
<title
>دليل مستخدم plasmaengineexplorer</title>
<date
>2017-01-09</date>
<releaseinfo
>بلازما 5.8</releaseinfo>
<productname
>سطح مكتب بلازما</productname>
</refentryinfo>

<refmeta>
<refentrytitle
><command
>plasmaengineexplorer</command
></refentrytitle>
<manvolnum
>1</manvolnum>
</refmeta>

<refnamediv>
<refname
><command
>plasmaengineexplorer</command
></refname>
<refpurpose
>يوفر وصولًا مباشرًا إلى محركات بيانات بلازما</refpurpose>
</refnamediv>

<refsynopsisdiv>
<cmdsynopsis
><command
>plasmaengineexplorer</command
> <group choice="opt"
><option
>-v, --version</option
></group
> <group choice="opt"
><option
>-h, --help</option
></group
> <group choice="opt"
><option
>--list</option
></group
> <group choice="opt"
><option
>--height</option
> <replaceable
>بكسل</replaceable
></group
> <group choice="opt"
><option
>--width</option
> <replaceable
>بكسل</replaceable
></group
> <group choice="opt"
><option
>-x</option
> <replaceable
>بكسل</replaceable
></group
> <group choice="opt"
><option
>-y</option
> <replaceable
>بكسل</replaceable
></group
> <group choice="opt"
><option
>--engine</option
> <replaceable
>محرك بيانات</replaceable
></group
> <group choice="opt"
><option
>--source</option
> <replaceable
>محرك بيانات</replaceable
></group
> <group choice="opt"
><option
>--interval</option
> <replaceable
>مللي ثانية</replaceable
></group
> <group choice="opt"
><option
